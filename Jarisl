# =========== РАБОТА С CLOUDFLARE AI ===========
async def get_ai_response(user_message: str, chat_id: int) -> str:
    logger.info(f"Запрос к Cloudflare AI: {user_message[:50]}...")
    
    async with httpx.AsyncClient(timeout=60) as client:
        try:
            response = await client.post(
                f"https://api.cloudflare.com/client/v4/accounts/{CF_ACCOUNT_ID}/ai/run/@cf/meta/llama-3.1-8b-instruct",
                headers={
                    "Authorization": f"Bearer {CF_API_TOKEN}",
                },
                json={
                    "messages": [
                        {"role": "system", "content": "Ты — Джарвис, вежливый помощник. Отвечай кратко, на 'Вы'."},
                        {"role": "user", "content": user_message}
                    ],
                    "max_tokens": 1000
                }
            )
            
            data = response.json()
            if data.get("success"):
                return data["result"]["response"].strip()
            else:
                logger.error(f"Ошибка Cloudflare: {data}")
                return "Извините, сервер не отвечает."
                
        except httpx.TimeoutException:
            logger.error("Таймаут Cloudflare")
            return "Извините, время ожидания истекло."
        except Exception as e:
            logger.error(f"Ошибка Cloudflare: {e}")
            return "Извините, я временно не могу ответить."

